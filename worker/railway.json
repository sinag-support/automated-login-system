{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "Dockerfile"
  },
  "deploy": {
    "numReplicas": 1,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 3,
    "cron": [
      {
        "schedule": "0 8 * * 1-6",
        "command": "curl -X POST http://localhost:3001/run-daily-logins -H 'x-api-key: ${API_KEY}'"
      }
    ]
  }
}